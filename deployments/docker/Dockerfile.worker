# Multi-stage build for the worker binary.

FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /bin/jobqueue-worker \
    ./cmd/worker/

FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata
RUN adduser -D -s /bin/sh jobqueue
USER jobqueue

WORKDIR /app

COPY --from=builder /bin/jobqueue-worker ./jobqueue-worker
COPY --chown=jobqueue:jobqueue migrations/ ./migrations/

ENTRYPOINT ["./jobqueue-worker"]
