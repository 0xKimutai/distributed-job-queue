# Production environment file for jobqueue services.
# Install to: /etc/jobqueue/env
# Permissions: sudo chown root:jobqueue /etc/jobqueue/env && sudo chmod 640 /etc/jobqueue/env
#
# This file is read by systemd's EnvironmentFile directive.
# Format: KEY=VALUE — no export, no quotes unless the value contains spaces.

DATABASE_URL=postgres://jobqueue:CHANGE_ME@localhost:5432/jobqueue?sslmode=require
API_PORT=8080
MIGRATIONS_PATH=/usr/local/share/jobqueue/migrations

WORKER_CONCURRENCY=5
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_POLL_INTERVAL=2s
